spes GPU: say whose page a fault was on; boot-arg gpu_host_ro for read-only host imports (0182).

Tiled mode (TU_DEBUG without sysmem) stops the GPU in seconds: FSR 0x80000408, fault address 0x25870000, FSYNR0
0x20013 (a write, a permission fault); the same FSR came in sysmem mode after App Library search. 39 read-only host
imports precede it. The report now names the buffer and the leaf entry; gpu_host_ro=1 refuses read-only imports,
gpu_host_ro=2 maps them writable (experiment). Default 0: nothing changes.

--- a/bsd/dev/spes_gpu_backend.h
+++ b/bsd/dev/spes_gpu_backend.h
@@ -39,6 +39,8 @@
  if (sg.gpu) touch_wr(sg.gpu, 0x2020u, 3u);
 }
 bool redwood_gpu_recover(void) { return false; }
+static int spes_gpu_owner(uint64_t address, uint64_t size);
+static uint64_t *spes_gpu_leaf(uint64_t address, bool create);
 void redwood_gpu_report(const char *why) {
  printf("SPES GPU: backend stopped: %s fence=%u tail=%u\n", why, sg.fence, sg.tail);
  if (sg.gpu) {
@@ -49,6 +51,20 @@
   /* 0180: where the SMMU fault was (context FAR 0x60/0x64) and what kind (FSYNR0 0x68: bit 4 a write) */
   printf("SPES GPU: fault address %#x:%#x FSYNR0=%#x\n", touch_rd(sg.smmu, sg.context + 0x64u),
       touch_rd(sg.smmu, sg.context + 0x60u), touch_rd(sg.smmu, sg.context + 0x68u));
+  /* 0182: whose page that is and how it is mapped now (leaf bit 7: read-only for the GPU). A
+   * permission fault on a page that is writable now would be a stale TLB entry. */
+  {
+   uint64_t far = ((uint64_t)touch_rd(sg.smmu, sg.context + 0x64u) << 32) | touch_rd(sg.smmu, sg.context + 0x60u);
+   int owner = spes_gpu_owner(far & ~4095ull, 1);
+   uint64_t *leaf = spes_gpu_leaf(far & ~4095ull, false);
+   uint64_t entry = leaf ? *leaf : 0;
+   if (owner >= 0)
+    printf("SPES GPU: fault page is %llu bytes into buffer %d (base %#llx, %llu bytes), leaf %#llx: %s\n",
+        (far & ~4095ull) - sg.buffers[owner].base, owner, sg.buffers[owner].base, sg.buffers[owner].size, entry,
+        !(entry & 1) ? "not mapped" : (entry & 0x80) ? "read-only" : "writable");
+   else
+    printf("SPES GPU: fault page is in no buffer, leaf %#llx\n", entry);
+  }
   printf("SPES GPU: SUBMIT_IB1 base=%#x:%#x remaining=%u\n",
       touch_rd(sg.gpu, 0x24a4u), touch_rd(sg.gpu, 0x24a0u), touch_rd(sg.gpu, 0x24a8u));
  }
