+/*
+ * debug.spes_fb_shot (0180, root only): what the display shows now. 8 bytes of width and
+ * height, then width x height BGRA pixels (sweet_fb_shot in SweetFramebuffer.cpp). Read it
+ * with "sysctl -b debug.spes_fb_shot > file". Not gated by spespmic: no PMIC involved.
+ */
+extern uint32_t sweet_fb_shot(uint8_t *dst, uint32_t size, uint32_t *dims);
+
+static int
+spes_fb_shot_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	uint32_t dims[2] = { 0, 0 };
+	uint32_t need = sweet_fb_shot(NULL, 0, dims);
+
+	if (!kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	if (need == 0) {
+		return ENXIO;
+	}
+	if (req->oldptr == USER_ADDR_NULL) {
+		req->oldidx = (size_t)need + 8;
+		return 0;
+	}
+	uint8_t *pixels = kalloc_data((size_t)need + 8, Z_WAITOK);
+	if (pixels == NULL) {
+		return ENOMEM;
+	}
+	memcpy(pixels, dims, 8);
+	(void)sweet_fb_shot(pixels + 8, need, dims);
+	int error = SYSCTL_OUT(req, pixels, (size_t)need + 8);
+	kfree_data(pixels, (size_t)need + 8);
+	return error;
+}
+SYSCTL_PROC(_debug, OID_AUTO, spes_fb_shot, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, spes_fb_shot_sysctl, "-", "spes: the picture on the display, BGRA after 8 bytes of size");
+
