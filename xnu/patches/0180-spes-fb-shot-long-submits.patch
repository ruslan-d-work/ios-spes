+/*
+ * spes 0180: what the display shows now, fWidth x fHeight BGRA rows without padding, for
+ * sysctl debug.spes_fb_shot. Screenshots come out black when backboardd draws with Metal,
+ * and a picture that is wrong has to be seen. The surface the pipe scans if there is one,
+ * else the panel memory. The GPU's pixels are in memory, not in this processor's cache:
+ * the lines are cleaned and dropped first. Returns the bytes needed; copies nothing if
+ * dst is NULL or too small.
+ */
+uint32_t
+AppleCLCD::shot(uint8_t *dst, uint32_t size, uint32_t *dims)
+{
+	uint32_t need = fWidth * fHeight * 4;
+
+	dims[0] = fWidth;
+	dims[1] = fHeight;
+	if (dst == NULL || size < need) {
+		return need;
+	}
+	IOLockLock(fLock);
+	SweetSurface *on = fScanned[0];
+	uintptr_t from = fPixels;
+	uint32_t pitch = fRowBytes;
+	if (on != NULL && on->kernelAddress() != 0 && on->bytesPerRow >= fWidth * 4) {
+		from = on->kernelAddress() + on->offset + (uint64_t)fOffY * on->bytesPerRow + (uint64_t)fOffX * 4;
+		pitch = on->bytesPerRow;
+	}
+	for (uintptr_t line = from & ~(uintptr_t)63; line < from + (uint64_t)pitch * fHeight; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t y = 0; y < fHeight; y++) {
+		memcpy(dst + (size_t)y * fWidth * 4, (const void *)(from + (uint64_t)y * pitch), (size_t)fWidth * 4);
+	}
+	IOLockUnlock(fLock);
+	return need;
+}
+
+extern "C" uint32_t sweet_fb_shot(uint8_t *dst, uint32_t size, uint32_t *dims);
+uint32_t
+sweet_fb_shot(uint8_t *dst, uint32_t size, uint32_t *dims)
+{
+	return gShotFB != NULL ? gShotFB->shot(dst, size, dims) : 0;
+}
