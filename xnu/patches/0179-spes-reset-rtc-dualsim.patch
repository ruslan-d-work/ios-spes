+/*
+ * spes (SM6225 + PM6125, SPMI PMIC arbiter v5): the PMIC real-time clock and a reset that
+ * can name the bootloader or the recovery, both through sysctl. Off unless the boot-arg
+ * spespmic=1 is given: the addresses are those of SM6225 (sm6125.dtsi spmi_bus, restart@440b000,
+ * msm-imem@c125000), wrong for sweet.
+ *
+ *   hw.spes_rtc (read only)   PM6125 RTC counter in seconds (0x6048..0x604b). Qualcomm's RTC
+ *                             cannot be set: userland keeps "wall clock - counter" in a file
+ *                             and adds it back at boot.
+ *   debug.spes_reset (write)  low 4 bits: 1 reset, 2 reset to the bootloader (fastboot),
+ *                             3 reset to the recovery. 0x10: first set PS_HOLD to a warm
+ *                             reset, 0x20: to a hard reset (what Linux does on this phone,
+ *                             "qcom,store-hard-reset-reason"); neither: leave the type the
+ *                             bootloader set. Nothing is unmounted or synced: run sync first.
+ *
+ * As Linux msm-poweroff.c + qpnp-power-on.c (gen2 PON): the reason goes into
+ * PON_SOFT_RB_SPARE (0x88f) bits 7:1 and the restart_reason cookie in IMEM, then PS_HOLD
+ * is dropped. PMIC WRITES: only 0x85a, 0x85b and 0x88f of USID 0, on the PON write channel
+ * (the keys driver uses the PON observer channel, which this file never touches). The RTC
+ * is read on its own observer channel.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define PM_CORE_PA      0x01c40000u
+#define PM_CHNLS_PA     0x01e00000u
+#define PM_OBS_PA       0x03e00000u
+#define PM_CNFG_PA      0x01c0a000u
+#define PM_PSHOLD_PA    0x0440b000u
+#define PM_IMEM_PA      0x0c125000u
+#define PM_IMEM_REASON  0x65cu
+#define PM_NO_APID      0xffffu
+
+static vm_offset_t pm_core, pm_obs, pm_cnfg, pm_wr, pm_pshold, pm_imem;
+static uint32_t pm_count;
+static uint16_t pm_wr_apid = PM_NO_APID;
+static int pm_state;                            /* 0 not tried, 1 ready, -1 off or failed */
+
+static uint32_t
+pm_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t value = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return value;
+}
+
+static void
+pm_wrl(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+/* v5 can map one PPID twice: the apps (EE 0) own one of them, only that one can be written */
+static uint16_t
+pm_find_apid(uint32_t ppid, bool owned)
+{
+	uint16_t found = PM_NO_APID;
+
+	for (uint32_t i = 0; i < pm_count; ++i) {
+		uint32_t map = pm_rd(pm_core, 0x900u + 4u * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		uint32_t owner = pm_rd(pm_cnfg, 0x700u + 4u * i) & 7u;
+		if (owner == 0) {
+			return (uint16_t)i;
+		}
+		if (!owned && found == PM_NO_APID) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+static bool
+pm_init(void)
+{
+	uint32_t on = 0;
+
+	if (pm_state != 0) {
+		return pm_state > 0;
+	}
+	pm_state = -1;
+	if (!PE_parse_boot_argn("spespmic", &on, sizeof(on)) || on == 0) {
+		return false;
+	}
+	pm_core = ml_io_map(PM_CORE_PA, 0x2000);
+	pm_cnfg = ml_io_map(PM_CNFG_PA, 0x1000);
+	pm_obs = ml_io_map(PM_OBS_PA, 0x10000);         /* EE 0: 512 channels of 0x80 */
+	pm_pshold = ml_io_map(PM_PSHOLD_PA, 0x1000);
+	pm_imem = ml_io_map(PM_IMEM_PA, 0x1000);
+	if (!pm_core || !pm_cnfg || !pm_obs || !pm_pshold || !pm_imem) {
+		printf("SPES PMIC: mapping failed\n");
+		return false;
+	}
+	uint32_t arb = pm_rd(pm_core, 0);
+	pm_count = pm_rd(pm_core, 4) & 0x7ffu;
+	if (arb < 0x50000000u || arb >= 0x70000000u || pm_count == 0 || pm_count > 512) {
+		printf("SPES PMIC: unsupported arbiter %#x with %u channels\n", arb, pm_count);
+		return false;
+	}
+	printf("SPES PMIC: arbiter %#x, %u channels\n", arb, pm_count);
+	pm_state = 1;
+	return true;
+}
+
+/* one register through the observer channel of its peripheral (EXT_READL, one byte) */
+static int
+pm_read(uint32_t addr, uint8_t *out)
+{
+	uint16_t apid = pm_find_apid(addr >> 8, false);
+
+	if (apid == PM_NO_APID) {
+		return -1;
+	}
+	uint32_t off = 0x80u * apid;
+	pm_wrl(pm_obs, off, (1u << 27) | ((addr & 0xffu) << 4));
+	for (unsigned i = 0; i < 2000; ++i) {
+		uint32_t status = pm_rd(pm_obs, off + 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				return -1;
+			}
+			*out = (uint8_t)pm_rd(pm_obs, off + 0x18u);
+			return 0;
+		}
+		delay(1);
+	}
+	return -1;
+}
+
+/* one PON register through the write channel the apps own (EXT_WRITEL, one byte) */
+static int
+pm_pon_write(uint32_t addr, uint8_t value)
+{
+	if (addr != 0x85au && addr != 0x85bu && addr != 0x88fu) {
+		return -1;
+	}
+	if (pm_wr_apid == PM_NO_APID) {
+		uint16_t apid = pm_find_apid(0x008u, true);
+		if (apid == PM_NO_APID) {
+			printf("SPES PMIC: the apps own no PON channel\n");
+			return -1;
+		}
+		pm_wr = ml_io_map(PM_CHNLS_PA + 0x10000u * apid, 0x1000);
+		if (!pm_wr) {
+			return -1;
+		}
+		pm_wr_apid = apid;
+	}
+	pm_wrl(pm_wr, 0x10u, value);
+	pm_wrl(pm_wr, 0x00u, (0u << 27) | ((addr & 0xffu) << 4));
+	for (unsigned i = 0; i < 2000; ++i) {
+		uint32_t status = pm_rd(pm_wr, 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				printf("SPES PMIC: write %#x refused, status %#x\n", addr, status);
+				return -1;
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	printf("SPES PMIC: write %#x timed out\n", addr);
+	return -1;
+}
+
+static int
+pm_rtc_seconds(uint32_t *out)
+{
+	uint8_t b[4], again;
+
+	for (unsigned attempt = 0; attempt < 3; ++attempt) {
+		for (unsigned i = 0; i < 4; ++i) {
+			if (pm_read(0x6048u + i, &b[i])) {
+				return -1;
+			}
+		}
+		/* the low byte must not have turned over while the others were read */
+		if (pm_read(0x6048u, &again)) {
+			return -1;
+		}
+		if (again == b[0]) {
+			*out = (uint32_t)b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16) |
+			    ((uint32_t)b[3] << 24);
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static int
+spes_rtc_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	uint32_t seconds = 0;
+
+	if (!pm_init() || pm_rtc_seconds(&seconds)) {
+		return ENXIO;
+	}
+	return SYSCTL_OUT(req, &seconds, sizeof(seconds));
+}
+SYSCTL_PROC(_hw, OID_AUTO, spes_rtc, CTLTYPE_INT | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, spes_rtc_sysctl, "IU", "PM6125 RTC counter, seconds");
+
+static int
+spes_reset_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	int value = 0;
+	int error = sysctl_handle_int(oidp, &value, 0, req);
+
+	if (error || req->newptr == USER_ADDR_NULL) {
+		return error;
+	}
+	unsigned what = (unsigned)value & 0x0fu, type = (unsigned)value & 0x30u;
+	if (what < 1 || what > 3 || ((unsigned)value & ~0x3fu) != 0 || type == 0x30u) {
+		return EINVAL;
+	}
+	if (!pm_init()) {
+		return ENXIO;
+	}
+	/* qpnp-power-on.c PON_RESTART_REASON_*: recovery 1, bootloader 2; msm-poweroff.c cookies */
+	uint8_t reason = what == 2 ? 0x02 : what == 3 ? 0x01 : 0x00;
+	uint32_t cookie = what == 2 ? 0x77665500u : what == 3 ? 0x77665502u : 0x77665501u;
+
+	printf("SPES PMIC: reset asked: %s, PS_HOLD type %s\n",
+	    what == 2 ? "bootloader" : what == 3 ? "recovery" : "plain",
+	    type == 0x10u ? "warm" : type == 0x20u ? "hard" : "as the bootloader left it");
+	if (pm_pon_write(0x88fu, (uint8_t)(reason << 1))) {
+		return EIO;
+	}
+	if (type != 0) {
+		/* qpnp_pon_system_pwr_off: disable, wait, type, enable */
+		if (pm_pon_write(0x85bu, 0x00)) {
+			return EIO;
+		}
+		delay(1000);
+		if (pm_pon_write(0x85au, type == 0x10u ? 0x01 : 0x07) || pm_pon_write(0x85bu, 0x80)) {
+			return EIO;
+		}
+		delay(1000);
+	}
+	pm_wrl(pm_imem, PM_IMEM_REASON, cookie);
+	printf("SPES PMIC: dropping PS_HOLD\n");
+	delay(200000);                                  /* let the console line out */
+	pm_wrl(pm_pshold, 0, 0);
+	delay(3000000);
+	printf("SPES PMIC: still running 3 s after PS_HOLD was dropped\n");
+	return EIO;
+}
+SYSCTL_PROC(_debug, OID_AUTO, spes_reset, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, spes_reset_sysctl, "I", "spes: reset (1), to the bootloader (2), to the recovery (3)");
+#endif
