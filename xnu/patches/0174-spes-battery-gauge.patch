+/*
+ * spesbatt=1 (iokit/Kernel/arm/SweetBattery.cpp): the spesn fuel gauge and charger sit on this
+ * bus too (live DT i2c@4a84000): sm5602 gauge at 0x71, bq2589x-compatible charger at 0x6a
+ * (Linux accepts bq25890, SYV690, SC89890H by REG14 PN), sc8551 charge pump at 0x66 and the
+ * rt1711h Type-C port at 0x4e. The SoC side is brought up exactly as spes_amp_init does (SE1
+ * clock vote, XO on the RCG, qup1 pin function, SE1 register setup); towards the chips the
+ * only bytes written are register pointers before a read. A word is two bytes in one FIFO
+ * word, low byte first (Linux sm5602 uses i2c_smbus_read_word_data). It refuses to run with
+ * spesamp (no lock between the two users of SE1) and off the spes platform.
+ */
+int spes_batt_i2c_open(void);
+int spes_batt_i2c_read(uint8_t addr, uint8_t reg, uint8_t *buf, unsigned len);
+
+static vm_offset_t batt_se;
+static int batt_bus;    /* 0 not tried, 1 usable, -1 unusable */
+
+/* A read of len (1 or 2) bytes after the pointer write; codes as amp_xfer. */
+static int
+batt_rx(vm_offset_t se, uint8_t addr, uint8_t *buf, uint32_t len)
+{
+	if (!amp_wait_clear(se, SE_STATUS, 1u)) {
+		return 3;
+	}
+	amp_wr(se, SE_IRQ_CLR, 0xffffffffu);
+	amp_wr(se, SE_TX_WM, 0);
+	amp_wr(se, SE_RX_LEN, len);
+	amp_wr(se, SE_CMD, (2u << 27) | ((uint32_t)addr << 9));
+	bool got = false;
+	for (unsigned i = 0; i < 5000; i++) {
+		uint32_t irq = amp_rd(se, SE_IRQ);
+		if (irq & SE_ERRORS) {
+			for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); j++) {
+				delay(1);
+				irq = amp_rd(se, SE_IRQ);
+			}
+			int err = (irq & SE_NACK) ? 1 : 2;
+			if ((irq & SE_DONE) && !(amp_rd(se, SE_STATUS) & 1u)) {
+				for (unsigned j = 0; j < 4 && (amp_rd(se, SE_RX_COUNT) & 0x1ffffffu); j++) {
+					(void)amp_rd(se, SE_RX);
+				}
+				amp_wr(se, SE_IRQ_CLR, irq);
+				return err;
+			}
+			return amp_abort(se) ? err : 3;
+		}
+		if (!got && (amp_rd(se, SE_RX_COUNT) & 0x1ffffffu)) {
+			uint32_t w = amp_rd(se, SE_RX);
+			for (uint32_t b = 0; b < len; b++) {
+				buf[b] = (uint8_t)(w >> (8u * b));
+			}
+			got = true;
+		}
+		if (irq & SE_DONE) {
+			amp_wr(se, SE_IRQ_CLR, irq);
+			return got ? 0 : 2;
+		}
+		amp_wr(se, SE_IRQ_CLR, irq & (3u << 26));
+		delay(1);
+	}
+	return amp_abort(se) ? 2 : 3;
+}
+
+static int
+batt_bus_up(void)
+{
+	DTEntry platform;
+	if (SecureDTLookupEntry(NULL, "/spes-platform", &platform) != kSuccess) {
+		printf("SPES BATT: not the spes platform; I2C not used\n");
+		return -1;
+	}
+	int amp = 0;
+	if (PE_parse_boot_argn("spesamp", &amp, sizeof(amp)) && amp != 0) {
+		printf("SPES BATT: spesamp=%d also drives SE1; battery I2C off\n", amp);
+		return -1;
+	}
+	vm_offset_t vpg = ml_io_map(AMP_GCC_PA + (AMP_GCC_VOTE & ~0xfffu), 0x1000u);
+	vm_offset_t rpg = ml_io_map(AMP_GCC_PA + (AMP_RCG & ~0xfffu), 0x1000u);
+	if (vpg == 0 || rpg == 0) {
+		printf("SPES BATT: no GCC mapping\n");
+		return -1;
+	}
+	const uint32_t rcg = AMP_RCG & 0xfffu;
+	uint32_t vote = amp_rd(vpg, AMP_GCC_VOTE & 0xfffu);
+	printf("SPES BATT: gcc vote %#x rcg %#x cfg %#x branch %#x before\n", vote,
+	    amp_rd(rpg, rcg), amp_rd(rpg, rcg + 4u), amp_rd(rpg, rcg - 4u));
+	if ((vote & AMP_GCC_BITS) != AMP_GCC_BITS) {
+		amp_wr(vpg, AMP_GCC_VOTE & 0xfffu, vote | AMP_GCC_BITS);
+	}
+	if ((amp_rd(rpg, rcg + 4u) & 0x71fu) != 1u) {
+		amp_wr(rpg, rcg + 4u, 1u);      /* XO, divider 1: 19.2 MHz */
+		amp_wr(rpg, rcg, amp_rd(rpg, rcg) | 1u);
+		if (!amp_wait_clear(rpg, rcg, 1u)) {
+			printf("SPES BATT: RCG update timeout\n");
+			return -1;
+		}
+	}
+	if (!amp_wait_clear(rpg, rcg - 4u, 1u << 31)) {
+		printf("SPES BATT: SE1 branch halted (%#x)\n", amp_rd(rpg, rcg - 4u));
+		return -1;
+	}
+	vm_offset_t se = ml_io_map(AMP_SE_PA, 0x4000);
+	vm_offset_t west = ml_io_map(AMP_WEST_PA + 0x4000u, 0x2000);   /* GPIO 4 and 5 */
+	if (se == 0 || west == 0) {
+		printf("SPES BATT: no SE1/TLMM mapping\n");
+		return -1;
+	}
+	uint32_t fw = amp_rd(se, 0x068), tx = amp_rd(se, 0xe24), rx = amp_rd(se, 0xe28);
+	bool i2c = ((fw >> 8) & 0xffu) == 3u && !(amp_rd(se, 0x64) & 1u) &&
+	    ((tx >> 24) & 0x3fu) == 32u && ((rx >> 24) & 0x3fu) == 32u;
+	printf("SPES BATT: se1 fw %#x proto %u status %#x tx %#x rx %#x%s\n", fw, (fw >> 8) & 0xffu,
+	    amp_rd(se, SE_STATUS), tx, rx, i2c ? "" : ": no usable I2C firmware");
+	if (!i2c) {
+		return -1;
+	}
+	for (uint32_t pin = 4; pin <= 5; pin++) {
+		uint32_t at = (pin - 4u) * 0x1000u, cfg = amp_rd(west, at);
+		if (((cfg >> 2) & 0xfu) != 1u) {
+			uint32_t want = (cfg & ~0x3cu) | (1u << 2) | 3u;   /* qup1, pull-up */
+			if (cfg & (1u << 11)) {
+				want |= 1u << 12;
+			}
+			amp_wr(west, at, want);
+		}
+		printf("SPES BATT: GPIO%u cfg %#x -> %#x, pad %s\n", pin, cfg, amp_rd(west, at),
+		    (amp_rd(west, at + 4u) & 1u) ? "high" : "LOW");
+	}
+	if (!amp_se_setup(se, rx)) {
+		printf("SPES BATT: SE1 setup refused\n");
+		return -1;
+	}
+	batt_se = se;
+	return 1;
+}
+
+int
+spes_batt_i2c_open(void)
+{
+	if (batt_bus == 0) {
+		batt_bus = batt_bus_up();
+	}
+	return batt_bus == 1 ? 0 : -1;
+}
+
+/* 0 ok, 1 NACK, 2 bus error, 3 engine stuck (the bus is then given up), -1 no bus. */
+int
+spes_batt_i2c_read(uint8_t addr, uint8_t reg, uint8_t *buf, unsigned len)
+{
+	if (batt_bus != 1 || len < 1 || len > 2) {
+		return -1;
+	}
+	int err = amp_msg(batt_se, addr, false, &reg);
+	if (err == 0) {
+		err = batt_rx(batt_se, addr, buf, len);
+	}
+	if (err == 3) {
+		printf("SPES BATT: SE1 engine stuck at %#x reg %#x; battery I2C off\n", addr, reg);
+		batt_bus = -1;
+	}
+	return err;
+}
