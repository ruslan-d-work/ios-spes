+/* One 16-bit register, low byte first; two equal reads in a row (no snapshot). */
+bool
+SweetBattery::spesWord(uint8_t addr, uint8_t reg, uint16_t *value)
+{
+	uint16_t previous = 0;
+	for (unsigned attempt = 0; attempt < 3; ++attempt) {
+		uint8_t b[2];
+		if (spes_batt_i2c_read(addr, reg, b, 2) != 0) {
+			return false;
+		}
+		uint16_t next = (uint16_t)((unsigned)b[0] | ((unsigned)b[1] << 8));
+		if (attempt && next == previous) {
+			*value = next;
+			return true;
+		}
+		previous = next;
+	}
+	return false;
+}
+
+bool
+SweetBattery::spesByte(uint8_t addr, uint8_t reg, uint8_t *value)
+{
+	return spes_batt_i2c_read(addr, reg, value, 1) == 0;
+}
+
+/*
+ * spesn (live DT /soc/i2c@4a84000): sm5602@71 gauge, bq2589x@6A charger.
+ * sm5602, decoded as the stock Android kernel does (its register table and
+ * fg_read_soc/fg_read_volt/fg_read_current disassembled from boot_b):
+ *   0x00 DEVICE_ID, 0x04 STATUS, 0x05 SOC: ((w >> 8) & 0x7f) * 10 +
+ *   (w & 0xff) * 10 / 256 in 0.1 %, bit 15 negative; 0x07 VOLTAGE: 2700 +
+ *   (w & 0x7fff) * 1800 / 19622 mV, bit 15 negative; 0x08 CURRENT:
+ *   (w & 0x7fff) * 1000 / 8 / 511 * 2 mA (sm,rsns = 0), bit 15 negative;
+ *   UI percent as Android: soc >= 1.7 % ? (soc * 10 + 96) / 97 : soc / 10.
+ * The current's sign convention is not known: it is published positive
+ * while the charger reports charging. Linux re-initializes the gauge when
+ * its parameters are lost (fg_check_reg_init_need); this never writes, so
+ * after a full battery disconnect the values may be meaningless.
+ * bq25890/SYV690/SC89890H (datasheet layout; PN = REG14[5:3] 3/1/4 as in
+ * the stock driver's detection): REG0B VBUS_STAT[7:5] CHRG_STAT[4:3]
+ * PG_STAT[2]; REG0C faults; REG0E BATV = 2304 + 20 * [6:0] mV; REG11
+ * VBUS_GD[7], VBUSV = 2600 + 100 * [6:0] mV; REG12 ICHGR = 50 * [6:0] mA.
+ */
+void
+SweetBattery::pollSpes(void)
+{
+	uint16_t id = 0, status = 0, soc = 0, volt = 0, curr = 0, tin = 0;
+	bool gauge = spesWord(0x71, 0x00, &id) && spesWord(0x71, 0x04, &status) &&
+	    spesWord(0x71, 0x05, &soc) && spesWord(0x71, 0x07, &volt) &&
+	    spesWord(0x71, 0x08, &curr);
+	(void)spesWord(0x71, 0x09, &tin);
+	int socx10 = ((soc >> 8) & 0x7f) * 10 + (soc & 0xff) * 10 / 256;
+	int mv = 2700 + (int)((volt & 0x7fffu) * 1800u / 19622u) * ((volt & 0x8000u) ? -1 : 1);
+	int ma = (int)((curr & 0x7fffu) * 1000u / 8u / 511u) * 2 * ((curr & 0x8000u) ? -1 : 1);
+	gauge = gauge && !(soc & 0x8000u) && socx10 <= 1000 && mv >= 2800 && mv <= 4600;
+
+	uint8_t pn = 0, st = 0, fault = 0, batv = 0, vbus = 0, ichg = 0;
+	unsigned part = 0;
+	bool charger = spesByte(0x6a, 0x14, &pn) &&
+	    ((part = (pn >> 3) & 7u) == 1 || part == 3 || part == 4) && spesByte(0x6a, 0x0b, &st) &&
+	    spesByte(0x6a, 0x0c, &fault) && spesByte(0x6a, 0x11, &vbus);
+	(void)spesByte(0x6a, 0x0e, &batv);
+	(void)spesByte(0x6a, 0x12, &ichg);
+	unsigned chrg = (st >> 3) & 3u;
+	bool external = charger && ((vbus & 0x80u) || (st & 0x04u));
+	bool charging = external && (chrg == 1 || chrg == 2);
+	bool full = external && chrg == 3;
+
+	unsigned percent = 0;
+	if (gauge) {
+		percent = socx10 >= 17 ? (unsigned)(socx10 * 10 + 96) / 97 : (unsigned)socx10 / 10;
+		if (percent > 100) {
+			percent = 100;
+		}
+		if (percent < 1) {
+			percent = 1;    /* never let a misread trigger a 0 % shutdown */
+		}
+		if (charging && ma < 0) {
+			ma = -ma;
+		}
+	}
+	unsigned flags = (gauge ? 1u : 0u) | (charger ? 2u : 0u) | (external ? 4u : 0u) |
+	    (charging ? 8u : 0u) | (full ? 16u : 0u);
+	if (fSpesPolls < 10 || fSpesPolls % 20 == 0 || percent != fSpesLastPercent ||
+	    flags != fSpesLastFlags) {
+		/* Two short lines: the live log cuts long ones. */
+		IOLog("SPES BATT: gauge %s id %#x st %#x soc %#x=%d.%d%%->%u%% v %#x=%dmV "
+		    "i %#x=%dmA tin %#x\n", gauge ? "ok" : "BAD", id, status, soc,
+		    socx10 / 10, socx10 % 10, percent, volt, mv, curr, ma, tin);
+		IOLog("SPES BATT: chg %s pn %#x st %#x flt %#x batv %umV vbus %#x=%umV "
+		    "ichg %umA ext=%d chg=%d full=%d\n", charger ? "ok" : "BAD", pn, st,
+		    fault, 2304u + 20u * (batv & 0x7fu), vbus, 2600u + 100u * (vbus & 0x7fu),
+		    50u * (ichg & 0x7fu), external, charging, full);
+	}
+	fSpesPolls++;
+	fSpesLastPercent = percent;
+	fSpesLastFlags = flags;
+	if (!gauge) {
+		if (++fSpesErrors == 10) {
+			IOLog("SPES BATT: gauge unreadable 10 times; static fallback stays\n");
+		}
+		fSpesGauge = false;
+		publish(100, 4200, 0, true, true, false, true, false, false);
+		return;
+	}
+	fSpesErrors = 0;
+	fSpesGauge = true;
+	publish(full ? 100 : percent, (unsigned)mv, ma, external, external, charging,
+	    full, true, true);
+}
