+// spes (userland/metal-patches/flame/0001): a call trace of what the client asks of each render pass, blit and dispatch, to settle
+// where a picture goes wrong (App Library: the blurred backdrop covers only the top third). Off unless NEGRONIMETAL_TRACE is set in
+// /var/db/negronimetal/env (bit 0: calls; bit 1: also read 8 rows of every traced target back after its encoder, through a blit
+// encoder of our own on the same command buffer, and log how much of each row is non-zero). Nothing is traced until the file
+// SPES_TRACE_TRIGGER exists: it is removed and the next NEGRONIMETAL_TRACE_COUNT command buffers (default 120) are written to
+// SPES_TRACE_LOG. Passes whose largest target side is under NEGRONIMETAL_TRACE_MIN pixels (default 64) are left out.
+// NEGRONIMETAL_DONTCARE chooses what a DontCare colour attachment that is not an IOSurface loads: clear (flame/0002, the default),
+// load (keep the texture's contents), first (clear the first time a pass targets a level, load after that) or keep (DontCare as asked).
+#define SPES_TRACE_TRIGGER "/var/db/negronimetal/trace"
+#define SPES_TRACE_LOG "/var/db/negronimetal/trace.log"
+static int gTrace,gTraceCount=120,gDontCare=1;
+static uint64_t gTraceMin=64;
+static std::atomic<int> gTraceLeft;
+static std::atomic<uint32_t> gTraceSeq;
+static std::atomic<uint64_t> gTraceChecked;
+static std::atomic<bool> gTraceStuck;
+static std::mutex gTraceLock;
+static FILE *gTraceFile;
+static void traceLine(const char *format,...) __attribute__((format(printf,1,2)));
+static void traceLine(const char *format,...) {
+ std::lock_guard<std::mutex> lock(gTraceLock);
+ if(!gTraceFile)gTraceFile=fopen(SPES_TRACE_LOG,"a");
+ if(!gTraceFile)return;
+ va_list args;va_start(args,format);vfprintf(gTraceFile,format,args);va_end(args);
+ fputc('\n',gTraceFile);
+}
+static void traceFlush() {std::lock_guard<std::mutex> lock(gTraceLock);if(gTraceFile)fflush(gTraceFile);}
+// A new command buffer's trace number, 0 for one that is not traced. Looks for the trigger at most five times a second.
+static uint32_t traceBegin() {
+ if(!gTrace)return 0;
+ if(gTraceLeft.load()<=0) {
+  if(gTraceStuck.load())return 0;
+  const uint64_t now=nowUs();uint64_t seen=gTraceChecked.load();
+  if(now-seen<200000 || !gTraceChecked.compare_exchange_strong(seen,now))return 0;
+  if(access(SPES_TRACE_TRIGGER,F_OK)!=0)return 0;
+  if(unlink(SPES_TRACE_TRIGGER)!=0)gTraceStuck=true;   // cannot remove it: trace once, not for ever
+  gTraceLeft=gTraceCount;
+  traceLine("== armed: %d command buffers, min %llu px, trace %d, dontcare %d, pid %d %s",gTraceCount,(unsigned long long)gTraceMin,gTrace,
+            gDontCare,(int)getpid(),getprogname());
+ }
+ if(gTraceLeft.fetch_sub(1)<=0){gTraceLeft=0;return 0;}
+ return ++gTraceSeq;
+}
+static bool traceBig(id t) {
+ if(![t isKindOfClass:[NBTexture class]])return false;
+ const NmbTextureDescriptor d=[(NBTexture *)t descriptor];
+ return std::max(d.width,d.height)>=gTraceMin;
+}
+// T<object> WxH f<format> L<levels> A<array> S<samples> u<usage> o<options>, surf/buf for an IOSurface or buffer texture, and a view's parent.
+static std::string traceTex(id t) {
+ if(!t)return "nil";
+ if(![t isKindOfClass:[NBTexture class]])return "foreign";
+ NBTexture *x=(NBTexture *)t;const NmbTextureDescriptor d=x.descriptor;char b[240];
+ snprintf(b,sizeof b,"T%p %llux%llu f%llu L%llu A%llu S%llu u0x%llx o0x%llx%s",(__bridge void *)x,(unsigned long long)d.width,
+          (unsigned long long)d.height,(unsigned long long)d.format,(unsigned long long)d.levels,(unsigned long long)d.array_length,
+          (unsigned long long)d.samples,(unsigned long long)d.usage,(unsigned long long)d.options,x.surface?" surf":x.buffer?" buf":"");
+ std::string s=b;
+ if(x.parent) {
+  snprintf(b,sizeof b," view(T%p L%lu S%lu)",(__bridge void *)x.parent,(unsigned long)x.parentLevel,(unsigned long)x.parentSlice);s+=b;
+ }
