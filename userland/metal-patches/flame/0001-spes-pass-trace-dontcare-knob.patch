+}
+// Eight rows of a traced target, copied into `buffer` by the command buffer itself and summed up when it completes.
+struct TraceRead {NmbBuffer *buffer;uint64_t row,height;std::string what;};
+// NEGRONIMETAL_DONTCARE=first: whether a render pass has targeted this level and slice of the texture (through any view) before; marks it.
+// Past level 15 or slice 3 the answer is always no (such a target is cleared every time, as under =clear).
+static bool passSeenBefore(NBTexture *texture,NSUInteger level,NSUInteger slice) {
+ for(int depth=0;depth<8 && texture.parent && [(id)texture.parent isKindOfClass:[NBTexture class]];depth++) {
+  level+=texture.parentLevel;slice+=texture.parentSlice;texture=(NBTexture *)texture.parent;
+ }
+ if(level>15 || slice>3)return false;
+ const uint64_t bit=1ull<<(level*4+slice);
+ const bool seen=(texture.passSeen&bit)!=0;
+ texture.passSeen|=bit;
+ return seen;
+}
