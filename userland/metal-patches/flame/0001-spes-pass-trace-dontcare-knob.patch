+// spes trace: copy eight rows (at 1/16, 3/16 ... 15/16 of the height) of each target into a buffer, after the encoder that wrote it.
+static void traceReadRows(NBCommandBuffer *commandBuffer,NSArray *targets) {
+ if(commandBuffer.committed || commandBuffer.encodeFailure)return;
+ for(NSArray *target in targets) {
+  NBTexture *texture=target[0];const NmbTextureDescriptor d=texture.descriptor;
+  const uint64_t level=[target[1] unsignedLongLongValue],slice=[target[2] unsignedLongLongValue];
+  const uint64_t texel=sweetTexelBytes((MTLPixelFormat)d.format);
+  const uint64_t storage=(d.options&MTLResourceStorageModeMask)>>MTLResourceStorageModeShift;
+  if(d.type!=MTLTextureType2D || d.samples>1 || storage==3 /* memoryless */) {
+   traceLine("  rows T%p: not read (type %llu samples %llu storage %llu)",(__bridge void *)texture,(unsigned long long)d.type,
+             (unsigned long long)d.samples,(unsigned long long)storage);
+   continue;
+  }
+  const uint64_t width=std::max<uint64_t>(d.width>>level,1),height=std::max<uint64_t>(d.height>>level,1),row=width*texel;
+  NmbBuffer *buffer=nmb_buffer_new(gDevice,row*8,MTLResourceStorageModeShared,nullptr);
+  NmbEncoder *blit=buffer?nmb_blit_encoder_new(commandBuffer.handle):nullptr;
+  if(!blit) {
+   traceLine("  rows T%p: no buffer or blit encoder: %s",(__bridge void *)texture,nmb_last_error());
+   if(buffer)nmb_buffer_release(buffer);
+   continue;
+  }
+  bool ok=true;
+  for(uint64_t k=0;k<8 && ok;k++) {
