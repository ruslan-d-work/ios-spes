+}
+// The first floats of a vertex or uniform block, as they are when it is set.
+static void traceFloats(const char *what,uint32_t stage,NSUInteger index,const void *bytes,uint64_t length) {
+ char text[480];text[0]=0;int n=0;const uint64_t count=std::min<uint64_t>(length/4,24);
+ for(uint64_t i=0;bytes && i<count;i++){float f;memcpy(&f,(const char *)bytes+i*4,4);n+=snprintf(text+n,sizeof text-(size_t)n," %.5g",(double)f);}
