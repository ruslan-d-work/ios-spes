+   ok=nmb_blit_texture_to_buffer(blit,texture.handle,slice,level,origin,size,buffer,k*row,row,row);
+  }
+  if(!ok)traceLine("  rows T%p: copy refused: %s",(__bridge void *)texture,nmb_last_error());
+  nmb_encoder_end(blit);
+  if(!ok){nmb_buffer_release(buffer);continue;}
+  char what[64];snprintf(what,sizeof what,"T%p L%llu",(__bridge void *)texture,(unsigned long long)level);
+  commandBuffer->traceReads.push_back(TraceRead{buffer,row,height,what});
+ }
